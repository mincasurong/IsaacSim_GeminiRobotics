# Gemini Robotics ER - Environment Configuration
# Copy this file to private/.env and fill in your values
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------
# DUAL-TIER MODEL ARCHITECTURE
# -------------------------------------------------------------

# Tier 1: Spatial Architect (Brainstorming & Geometry Planning)
# This model converts natural language goals into precise X,Y coordinates.
# Recommended: gemini-2.5-pro (or gemini-3.7-flash if available) for best reasoning.
PLANNER_MODEL=gemini-2.5-pro

# Tier 2: VLA Orchestrator (Perception & Robotic Actions)
# This model looks at the camera feed and issues robotic actions (pick, place).
# Recommended: gemini-2.5-flash or gemini-robotics-er-2 for fast visual-action loops.
ROBOTICS_MODEL=gemini-2.5-flash
