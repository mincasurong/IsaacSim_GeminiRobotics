# LLM Provider Configuration
LLM_PROVIDER=google
LLM_API_KEY=your_google_api_key_here

# LLM Model Selection
PLANNER_MODEL=gemini-3.7-flash
DIAGNOSIS_MODEL=gemini-3.7-flash
EMBEDDING_MODEL=models/gemini-embedding-2

# Virtual Devices Server URL
VIRTUAL_DEVICES_URL=http://localhost:8001

# Execution Settings
TIMEOUT_SEC=30
RETRY_LIMIT=3

# Gemini Robotics-ER (VLM for robotic perception & orchestration)
ROBOTICS_MODEL=gemini-robotics-er-2-preview
