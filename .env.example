# Gemini Robotics ER - Environment Configuration
# Copy this file to private/.env and fill in your values
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------
# DUAL-TIER MODEL ARCHITECTURE
# -------------------------------------------------------------
# Official Models Reference: 
# - https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash
# - https://ai.google.dev/gemini-api/docs/models/gemini-3.1-pro-preview
# - https://ai.google.dev/gemini-api/docs/robotics-overview

# Tier 1: Spatial Architect (Brainstorming & Geometry Planning)
# This model converts natural language goals into precise X,Y coordinates.
# Recommended: gemini-3.5-flash-lite (high speed, 4M TPM quota, avoids opencode session collisions).
PLANNER_MODEL=gemini-3.5-flash-lite

# Tier 2: VLA Orchestrator (Perception & Robotic Actions)
# This model looks at the camera feed and issues robotic actions (pick, place).
# Recommended: gemini-robotics-er-2-preview for optimal visual-language-action looping.
ROBOTICS_MODEL=gemini-robotics-er-2-preview

# -------------------------------------------------------------
# Tier 3: Real-Time Monitoring & Anomaly Diagnostic Agent
# -------------------------------------------------------------
# This model ingests continuous logs from Isaac Sim and ROS 2 (/rosout, /tf, /metrics)
# and produces structured operational health summaries, ghost-grasp audits, and safety alerts.
# Recommended: gemini-3.5-flash-lite (high speed, 4M TPM context window, cost-effective log audits).
MONITORING_MODEL=gemini-3.5-flash-lite

# Execution Mode: 'visual_flow' (deterministic zero-token node workflow) or 'vla' (Gemini autonomous)
EXECUTION_MODE=visual_flow
